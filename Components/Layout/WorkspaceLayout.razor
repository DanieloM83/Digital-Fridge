@inherits LayoutComponentBase

<div class="workspace-layout d-flex flex-column v-100">
    <Header />

    <main class="workspace-main flex-grow-1 d-flex flex-column">
        @Body
    </main>

    <WorkspaceNavDash />
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["Common_UnhandledError"]
    <a href="." class="reload">@L["Common_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

