@*
    GoogleSignInButton - Renders Google's official Sign In button via GSI library.
    Place the GSI script in App.razor <head>; this component renders the target div.
*@

<div id="g_id_onload" data-client_id="YOUR_GOOGLE_CLIENT_ID" data-login_uri="/api/auth/google-callback"
     data-auto_prompt="false">
</div>
<div class="g_id_signin" data-type="standard" data-size="large" data-theme="outline" data-text="sign_in_with"
     data-shape="rectangular" data-logo_alignment="left">
</div>


