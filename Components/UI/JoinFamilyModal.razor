@*
    JoinFamilyModal - Bootstrap confirmation modal for joining a new family.
    Caller opens it via data-bs-toggle="modal" data-bs-target="#joinModal".
*@

<div class="modal fade" id="joinModal" tabindex="-1" aria-labelledby="joinModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-glass">

            <div class="modal-header border-0">
                <h5 class="modal-title text-white" id="joinModalLabel">
                    <i class="bi bi-people me-2 text-accent" aria-hidden="true"></i>Are you sure?
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body text-white-50">
                <p class="mb-0">
                    Your personal recipes remain yours, but storage and family recipes will be
                    updated with the new family's content.
                    @if (IsHead)
                    {
                        <span> All your family members will be moved to the new family with you.</span>
                    }
                </p>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-accent" data-bs-dismiss="modal" @onclick="OnConfirm">
                    Proceed
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public bool IsHead { get; set; }
    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }
}

