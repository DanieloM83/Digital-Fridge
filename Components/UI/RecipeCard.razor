@*
    RecipeCard - Displays an individual recipe in the catalog with edge-to-edge image,
    title, short description, ingredient badges, and metadata (prep time & servings).
*@

<div class="card recipe-card h-100 bg-transparent text-white">
    @if (!string.IsNullOrEmpty(Recipe.ImageUrl))
    {
        <div class="recipe-card-img-wrapper">
            <img src="@Recipe.ImageUrl" class="card-img-top recipe-card-img" alt="@Recipe.Title" loading="lazy" />
        </div>
    }

    <div class="card-body d-flex flex-column p-4">
        <h5 class="card-title fw-bold mb-2">@Recipe.Title</h5>

        <p class="card-text text-white-50 mb-3 small flex-grow-1">
            @(Recipe.ShortDescription ?? "A mouth-watering dish crafted with fresh ingredients.")
        </p>

        @if (Recipe.Ingredients.Count > 0)
        {
            <div class="mb-3 d-flex flex-wrap gap-1" aria-label="Ingredients">
                @foreach (var ingredient in Recipe.Ingredients)
                {
                    <span class="badge ingredient-badge">@ingredient.Name</span>
                }
            </div>
        }

        <div class="card-footer bg-transparent border-top border-white-10 d-flex justify-content-between align-items-center px-0 pt-3 pb-0 small text-white-50">
            <span>
                <i class="bi bi-clock me-1 text-accent" aria-hidden="true"></i>
                @Recipe.PrepTimeMinutes mins
            </span>
            <span>
                <i class="bi bi-people me-1 text-accent" aria-hidden="true"></i>
                @Recipe.Servings @(Recipe.Servings == 1 ? "serving" : "servings")
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Recipe Recipe { get; set; } = default!;
}

