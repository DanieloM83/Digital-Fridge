@page "/Error"
@using System.Diagnostics

<PageTitle>@L["Error_PageTitle"]</PageTitle>

<section class="error-hero d-flex align-items-center justify-content-center">
    <ErrorCard Title="@L["Error_Title"]"
               Message="@L["Error_Message"]" />
</section>

@if (ShowRequestId)
{
    <div class="text-center py-2">
        <small class="text-white-50">@L["Error_RequestId"] <code>@RequestId</code></small>
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext
    {
        get; set;
    }

    private string? RequestId
    {
        get; set;
    }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
