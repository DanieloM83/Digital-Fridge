@page "/workspace/recipes"
@layout WorkspaceLayout
@attribute [Authorize]

<PageTitle>Saved Recipes - Workspace</PageTitle>

<div class="container-fluid flex-grow-1 d-flex flex-column align-items-center justify-content-center text-white p-4">
    <div class="text-center">
        <i class="bi bi-book text-accent display-4 mb-3 d-block" aria-hidden="true"></i>
        <h2 class="fw-bold mb-2">My Recipes</h2>
        <p class="text-white-50">View your private bookmarks and family shared recipe collections.</p>
    </div>
</div>

