@page "/workspace/generate"
@layout WorkspaceLayout
@attribute [Authorize]

<PageTitle>Generate - Workspace</PageTitle>

<div class="container-fluid flex-grow-1 d-flex flex-column align-items-center justify-content-center text-white p-4">
    <div class="text-center">
        <i class="bi bi-arrow-clockwise text-accent display-4 mb-3 d-block" aria-hidden="true"></i>
        <h2 class="fw-bold mb-2">Generate Meals</h2>
        <p class="text-white-50">Generate personalized recipe ideas using items currently in your fridge.</p>
    </div>
</div>

