@page "/workspace/add-product"
@layout WorkspaceLayout
@attribute [Authorize]

<PageTitle>Add Product - Workspace</PageTitle>

<div class="container-fluid flex-grow-1 d-flex flex-column align-items-center justify-content-center text-white p-4">
    <div class="text-center">
        <i class="bi bi-patch-plus text-accent display-4 mb-3 d-block" aria-hidden="true"></i>
        <h2 class="fw-bold mb-2">Add Product</h2>
        <p class="text-white-50">Scan barcodes or add fresh groceries to your digital inventory.</p>
    </div>
</div>

