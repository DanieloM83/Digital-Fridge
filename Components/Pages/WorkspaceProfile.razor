@*
    WorkspaceProfile - User profile, family management, and member list.
    Interactive server component: loads user+family from DB, handles join/leave/kick actions.
*@

@page "/workspace/profile"
@layout WorkspaceLayout
@attribute [Authorize]
@rendermode InteractiveServer

@inject IAuthRepository AuthRepository
@inject IFamilyService FamilyService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Profile - Workspace</PageTitle>

@if (_user is null)
{
    <div class="d-flex justify-content-center align-items-center flex-grow-1 p-4">
        <div class="spinner-border text-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="profile-page p-3 p-md-4 d-flex flex-column gap-3">

        @* 1. Profile card *@
        <div class="glass-card p-4 d-flex align-items-center gap-3 flex-wrap">
            <img src="@_user.AvatarUrl" alt="Avatar" class="profile-avatar" />
            <div class="flex-grow-1">
                <h5 class="fw-bold text-white mb-1">@(_user.FullName ?? _user.Email)</h5>
                <span class="badge role-badge">@RoleLabel</span>
            </div>
            <a href="/api/auth/logout" class="btn btn-outline-light btn-sm">
                <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Logout
            </a>
        </div>

        @* 2. Family ID + Leave  *@
        <div class="glass-card p-4 d-flex align-items-center gap-3 flex-wrap">
            <div class="flex-grow-1">
                <span class="text-white small text-uppercase tracking-wide">@_family.Name</span>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <code class="family-id-code" title="@_user.FamilyId.ToString()">
                        @_user.FamilyId.ToString()[..8]…
                    </code>
                    <button class="btn btn-sm btn-ghost-icon" title="Copy full Family ID"
                            @onclick="CopyFamilyId">
                        <i class="bi @(_copied ? "bi-check2" : "bi-clipboard")" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            @if (_user.Role == UserRole.FamilyMember)
            {
                <button class="btn btn-outline-warning btn-sm"
                        data-bs-toggle="modal" data-bs-target="#leaveModal">
                    <i class="bi bi-door-open me-1" aria-hidden="true"></i>Leave family
                </button>
            }
        </div>

        @* 3. Join family *@
        <div class="glass-card p-4">
            <label for="joinInput" class="form-label text-white-50 small text-uppercase">
                Join another family
            </label>
            <div class="d-flex gap-2 flex-wrap">
                <input id="joinInput"
                       type="text"
                       class="form-control form-control-dark flex-grow-1"
                       placeholder="New family ID…"
                       maxlength="36"
                       @bind="_joinInput"
                       @bind:event="oninput" />
                <button class="btn btn-accent"
                        disabled="@string.IsNullOrWhiteSpace(_joinInput)"
                        data-bs-toggle="modal" data-bs-target="#joinModal">
                    <i class="bi bi-people me-1" aria-hidden="true"></i>Join family
                </button>
            </div>
            @if (_joinError is not null)
            {
                <p class="text-warning mt-2 mb-0 small">
                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>@_joinError
                </p>
            }
        </div>

        @* 4. Family members grid *@
        @if (_family is not null)
        {
            <div class="glass-card p-4">
                <h6 class="text-white-50 small text-uppercase mb-3">
                    Family members (@_family.Members.Count)
                </h6>
                <div class="table-responsive">
                    <table class="table table-dark table-hover members-table mb-0">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Role</th>
                                <th>Joined</th>
                                @if (_user.Role == UserRole.FamilyHead)
                                {
                                    <th>Action</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in _family.Members.OrderBy(m => m.CreatedAt))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@member.AvatarUrl" alt=""
                                                 class="member-avatar" />
                                            <span class="text-white">
                                                @(member.FullName ?? member.Email)
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @RoleBadgeClass(member.Role)">
                                            @GetRoleLabel(member.Role)
                                        </span>
                                    </td>
                                    <td class="text-white-50 small align-middle">
                                        @member.JoinedAt.ToLocalTime().ToString("MMM d, yyyy")
                                    </td>
                                    @if (_user.Role == UserRole.FamilyHead)
                                    {
                                        <td>
                                            @if (member.UserId != _user.UserId)
                                            {
                                                <button class="btn btn-outline-danger btn-sm"
                                                        @onclick="() => OpenKickModal(member)">
                                                    <i class="bi bi-person-x me-1" aria-hidden="true"></i>Kick
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @* Modals *@

    @* Join confirmation *@
    <div class="modal fade" id="joinModal" tabindex="-1" aria-labelledby="joinModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-glass">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-white" id="joinModalLabel">
                        <i class="bi bi-people me-2 text-accent" aria-hidden="true"></i>Are you sure?
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-white-50">
                    <p class="mb-0">
                        Your personal recipes remain yours, but storage and family recipes will be
                        updated with the new family's content.
                        @if (_user.Role == UserRole.FamilyHead)
                        {
                            <span> All your family members will be moved to the new family with you.</span>
                        }
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-accent" data-bs-dismiss="modal"
                            @onclick="JoinFamilyAsync">
                        Proceed
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Leave confirmation *@
    <div class="modal fade" id="leaveModal" tabindex="-1" aria-labelledby="leaveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-glass">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-white" id="leaveModalLabel">
                        <i class="bi bi-door-open me-2 text-accent" aria-hidden="true"></i>Are you sure?
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-white-50">
                    <p class="mb-0">
                        Your personal recipes remain yours, but you will lose access to this family's
                        storage and shared recipes. You will become the head of your own household.
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" data-bs-dismiss="modal"
                            @onclick="LeaveFamilyAsync">
                        Leave family
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Kick confirmation *@
    <div class="modal fade" id="kickModal" tabindex="-1" aria-labelledby="kickModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-glass">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-white" id="kickModalLabel">
                        <i class="bi bi-person-x me-2 text-accent" aria-hidden="true"></i>Are you sure?
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-white-50">
                    <p class="mb-0">
                        <strong class="text-white">@(_kickTarget?.FullName ?? _kickTarget?.Email)</strong>
                        will be removed from your family and placed in their own household.
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal"
                            @onclick="KickMemberAsync">
                        Kick
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private User? _user;
    private Family? _family;
    private string _joinInput = string.Empty;
    private string? _joinError;
    private User? _kickTarget;
    private bool _copied;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdStr, out var userId)) return;

        _user = await AuthRepository.GetUserByIdAsync(userId);
        if (_user is not null)
            _family = await FamilyService.GetFamilyWithMembersAsync(_user.FamilyId);
    }

    private async Task JoinFamilyAsync()
    {
        _joinError = null;
        if (_user is null || !Guid.TryParse(_joinInput.Trim(), out var targetId))
        {
            _joinError = "Please enter a valid family ID (UUID format).";
            return;
        }

        var success = await FamilyService.JoinFamilyAsync(_user.UserId, targetId);
        if (!success)
        {
            _joinError = "Family not found. Double-check the ID and try again.";
            return;
        }

        // Reload
        _user = await AuthRepository.GetUserByIdAsync(_user.UserId);
        _family = _user is not null
            ? await FamilyService.GetFamilyWithMembersAsync(_user.FamilyId)
            : null;
        _joinInput = string.Empty;
    }

    private async Task LeaveFamilyAsync()
    {
        if (_user is null) return;
        await FamilyService.LeaveToSoloFamilyAsync(_user.UserId);

        _user = await AuthRepository.GetUserByIdAsync(_user.UserId);
        _family = _user is not null
            ? await FamilyService.GetFamilyWithMembersAsync(_user.FamilyId)
            : null;
    }

    private async Task OpenKickModal(User member)
    {
        _kickTarget = member;
        await JS.InvokeVoidAsync("showModal", "kickModal");
    }

    private async Task KickMemberAsync()
    {
        if (_kickTarget is null || _user is null) return;
        await FamilyService.KickMemberAsync(_kickTarget.UserId);

        _family = await FamilyService.GetFamilyWithMembersAsync(_user.FamilyId);
        _kickTarget = null;
    }

    private async Task CopyFamilyId()
    {
        // Clipboard write is JS-only; we toggle an icon as lightweight feedback.
        // Full clipboard support can be wired via JSInterop if desired.
        _copied = true;
        await Task.Delay(1500);
        _copied = false;
    }

    private string RoleLabel => GetRoleLabel(_user?.Role ?? UserRole.Guest);
    private static string GetRoleLabel(UserRole role) => role switch
    {
        UserRole.FamilyHead => "Family Head",
        UserRole.FamilyMember => "Family Member",
        UserRole.Admin => "Admin",
        _ => "Guest"
    };

    private static string RoleBadgeClass(UserRole role) => role switch
    {
        UserRole.FamilyHead => "bg-accent-badge",
        _ => "bg-secondary"
    };
}
